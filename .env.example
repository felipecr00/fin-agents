# Copia a .env (ignorado por git) o exporta estas variables en tu shell. Nunca se commitean.
# Opción A — Gemini API (Google AI Studio):
GOOGLE_API_KEY=
# Opción B — Vertex AI en modo express: API key de GCP restringida a aiplatform.googleapis.com.
# Es la que usa dev en Cloud Run (ADR-008). NO definas GOOGLE_CLOUD_PROJECT/LOCATION junto a
# ella: el SDK ignoraría la llave y usaría las credenciales de gcloud (ADC).
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_ENTERPRISE=True
# Opción C — Vertex AI con `gcloud auth application-default login` (sin llave):
# GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
